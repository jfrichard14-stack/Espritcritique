# ------------------------------------------------------------
# Esprit Critique — variables d'environnement
#
# Copier ce fichier vers .env.local et renseigner les valeurs.
# .env.local n'est jamais versionné.
# ------------------------------------------------------------

# Projet Supabase. En local : valeurs affichées par `npx supabase start`.
# En production : Project Settings > API dans le tableau de bord Supabase.
# Choisir impérativement une région de l'Union européenne à la création
# du projet (Frankfurt ou Ireland) : les productions des étudiants sont
# des données personnelles.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clé de service : contourne toutes les politiques de sécurité.
# Jamais exposée au navigateur, jamais préfixée NEXT_PUBLIC_.
# Sert uniquement à promouvoir un compte en formateur.
SUPABASE_SERVICE_ROLE_KEY=

# URL publique du site, utilisée dans les liens des courriels
# de confirmation d'inscription.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
